<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSnakeScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="得分:5" />

        <com.example.mymemo.widget.StudyProgressRingView
            android:id="@+id/progressRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:ringProgressColor="@color/ring_progress"
            app:ringTextColor="@color/ring_text"
            app:ringTrackColor="@color/ring_track"
            app:ringTextSize="11sp"
            app:ringWidth="6dp" />

    </LinearLayout>

    <com.example.mymemo.widget.SnakeBoardView
        android:id="@+id/snakeBoard"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvSnakeRewardHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/snake_reward_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 十字方位方向键(小键盘 8/4/6/2):四个按键复用同一三角形 drawable 并旋转指向 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dirPad"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_snake_dir_button"
            android:contentDescription="@string/snake_dir_up"
            android:rotation="0"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_snake_dir"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/snake_dir_icon" />

        <ImageButton
            android:id="@+id/btnLeft"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_snake_dir_button"
            android:contentDescription="@string/snake_dir_left"
            android:rotation="270"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_snake_dir"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/snake_dir_icon" />

        <ImageButton
            android:id="@+id/btnRight"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_snake_dir_button"
            android:contentDescription="@string/snake_dir_right"
            android:rotation="90"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_snake_dir"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/snake_dir_icon" />

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_snake_dir_button"
            android:contentDescription="@string/snake_dir_down"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_snake_dir"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/snake_dir_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
